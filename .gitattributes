# ===============================================================
#  Fare Play - .gitattributes (Unity + Git LFS)
#  Must be committed BEFORE any art/audio/model files are added.
# ===============================================================

# Normalize line endings for anything Git detects as text
* text=auto

# ---------- Code & scripts ----------
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text
*.uss       text
*.uxml      text
*.json      text
*.md        text
*.txt       text
*.inputactions text
*.sh        text eol=lf

# ---------- Unity YAML files ----------
# Kept as text so Git can diff/merge them. linguist-generated collapses
# their (unreadable) diffs in pull requests so reviews stay focused on code.
*.unity              text eol=lf linguist-generated
*.prefab             text eol=lf linguist-generated
*.meta               text eol=lf linguist-generated
*.asset              text eol=lf linguist-generated
*.mat                text eol=lf linguist-generated
*.anim               text eol=lf linguist-generated
*.controller         text eol=lf linguist-generated
*.overrideController text eol=lf linguist-generated
*.physicMaterial     text eol=lf linguist-generated
*.physicsMaterial2D  text eol=lf linguist-generated
*.playable           text eol=lf linguist-generated
*.mask               text eol=lf linguist-generated
*.renderTexture      text eol=lf linguist-generated
*.spriteatlas        text eol=lf linguist-generated
*.terrainlayer       text eol=lf linguist-generated
*.lighting           text eol=lf linguist-generated
*.fontsettings       text eol=lf linguist-generated
*.guiskin            text eol=lf linguist-generated

# ---------- Git LFS: big binary files ----------
# (Bracket patterns catch .PNG / .Wav etc. from screenshot tools and cameras.)

# Some .asset files are binary even in Force Text mode
LightingData.asset   filter=lfs diff=lfs merge=lfs -text

# Images
*.[pP][nN][gG]       filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][gG]       filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][eE][gG]   filter=lfs diff=lfs merge=lfs -text
*.[pP][sS][dD]       filter=lfs diff=lfs merge=lfs -text
*.[tT][gG][aA]       filter=lfs diff=lfs merge=lfs -text
*.[tT][iI][fF]       filter=lfs diff=lfs merge=lfs -text
*.[tT][iI][fF][fF]   filter=lfs diff=lfs merge=lfs -text
*.[gG][iI][fF]       filter=lfs diff=lfs merge=lfs -text
*.[bB][mM][pP]       filter=lfs diff=lfs merge=lfs -text
*.[eE][xX][rR]       filter=lfs diff=lfs merge=lfs -text
*.[hH][dD][rR]       filter=lfs diff=lfs merge=lfs -text

# Audio
*.[wW][aA][vV]       filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]3          filter=lfs diff=lfs merge=lfs -text
*.[oO][gG][gG]       filter=lfs diff=lfs merge=lfs -text
*.[aA][iI][fF]       filter=lfs diff=lfs merge=lfs -text
*.[aA][iI][fF][fF]   filter=lfs diff=lfs merge=lfs -text
*.[fF][lL][aA][cC]   filter=lfs diff=lfs merge=lfs -text

# 3D models
*.[fF][bB][xX]       filter=lfs diff=lfs merge=lfs -text
*.[oO][bB][jJ]       filter=lfs diff=lfs merge=lfs -text
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
*.[dD][aA][eE]       filter=lfs diff=lfs merge=lfs -text
*.3[dD][sS]          filter=lfs diff=lfs merge=lfs -text
*.[gG][lL][bB]       filter=lfs diff=lfs merge=lfs -text

# Video
*.[mM][pP]4          filter=lfs diff=lfs merge=lfs -text
*.[mM][oO][vV]       filter=lfs diff=lfs merge=lfs -text
*.[wW][eE][bB][mM]   filter=lfs diff=lfs merge=lfs -text

# Fonts
*.[tT][tT][fF]       filter=lfs diff=lfs merge=lfs -text
*.[oO][tT][fF]       filter=lfs diff=lfs merge=lfs -text

# Native plugins, archives, documents
*.dll                filter=lfs diff=lfs merge=lfs -text
*.so                 filter=lfs diff=lfs merge=lfs -text
*.dylib              filter=lfs diff=lfs merge=lfs -text
*.zip                filter=lfs diff=lfs merge=lfs -text
*.7z                 filter=lfs diff=lfs merge=lfs -text
*.[pP][dD][fF]       filter=lfs diff=lfs merge=lfs -text
